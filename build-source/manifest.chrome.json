{
  "manifest_version": 3,
  "name": "SentenceTTS Reader",
  "version": "2.3.4",
  "description": "Reads any webpage or PDF aloud with live sentence highlighting — offline via your browser's voices or the built-in Kokoro engine, or online with Google Cloud Text-to-Speech (incl. English-India neural voices). Piper needs a one-time local setup; the popup shows the steps.",
  "key": "{{SPKI_B64}}",
  "minimum_chrome_version": "119",
  "permissions": ["storage", "activeTab", "nativeMessaging", "offscreen"],
  "host_permissions": [
    "<all_urls>",
    "file:///*",
    "https://texttospeech.googleapis.com/*",
    "https://translate.google.com/*",
    "https://huggingface.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["spa-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SentenceTTS Reader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}